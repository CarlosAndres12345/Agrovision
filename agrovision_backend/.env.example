# Django
# En desarrollo puedes dejar DJANGO_SECRET_KEY vacío (se usa un valor no
# sensible de solo-desarrollo); en producción es obligatorio.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# PostgreSQL — desarrollo local (ignoradas si DATABASE_URL está definida).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Producción/Vercel — si está presente, tiene prioridad sobre las DB_* de
# arriba (formato: postgres://usuario:password@host:puerto/nombre_bd).
DATABASE_URL=

# URLs del frontend/backend desplegados — usadas para CORS/CSRF en producción.
# Deben incluir el esquema, p. ej. https://mi-frontend.vercel.app
FRONTEND_URL=
BACKEND_URL=

# Hosts adicionales permitidos además de localhost/127.0.0.1/*.vercel.app,
# coma-separados (opcional).
DJANGO_ALLOWED_HOSTS=

# Cloudinary — repositorio externo de imágenes (solo backend, nunca al frontend).
# OPCIONAL: cada usuario configura su propio repositorio desde la interfaz
# (módulo Repositorio → "Configurar repositorio"), cifrado en base de datos.
# Completar estas variables solo sirve como repositorio de fallback para
# usuarios que todavía no configuraron uno propio — puedes dejarlas vacías.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional: valor inicial del repositorio de fallback. La carpeta real a
# sincronizar se elige desde la interfaz (no hace falta editar esto ni
# reiniciar el backend para usar una carpeta nueva creada en Cloudinary).
CLOUDINARY_DEFAULT_FOLDER=agrovision

# Clave de cifrado para los api_secret guardados por usuario (opcional). Si se
# omite, se deriva de SECRET_KEY. Fijar una propia en producción permite
# rotar SECRET_KEY sin perder los secretos ya cifrados en BD. Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REPOSITORY_ENCRYPTION_KEY=

# Geocodificación — opcional, valores por defecto usan Nominatim/OpenStreetMap.
# Cambia NOMINATIM_BASE_URL para apuntar a otro proveedor sin tocar código.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AgriVisionOS/1.0 (+https://github.com/agrovision)

# Dispositivo de inferencia de Mask R-CNN — opcional. "auto" (por defecto)
# detecta GPU (CUDA) y usa CPU si no hay ninguna disponible. Forzar con
# ML_DEVICE=cpu o ML_DEVICE=cuda.
ML_DEVICE=auto
