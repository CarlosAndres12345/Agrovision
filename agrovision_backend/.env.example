# Django
# En desarrollo puedes dejar DJANGO_SECRET_KEY vacío (se usa un valor no
# sensible de solo-desarrollo); en producción (DJANGO_DEBUG=False) es
# obligatorio, o Django no arranca.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Producción — si está presente, tiene prioridad sobre las POSTGRES_* de
# abajo (formato: postgres://usuario:password@host:puerto/nombre_bd).
DATABASE_URL=

# PostgreSQL — desarrollo local (ignoradas si DATABASE_URL está definida).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS/CSRF — orígenes exactos permitidos, coma-separados. En producción
# reemplaza por la(s) URL(s) reales del frontend (con esquema https://).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Alternativa/complemento a lo anterior: si solo tienes una URL de frontend
# (y opcionalmente de backend), se agregan automáticamente a las listas de
# arriba sin tener que repetirlas. Deben incluir esquema https://.
FRONTEND_URL=
BACKEND_URL=

# Fuerza redirección HTTP -> HTTPS a nivel de Django — déjalo en False si tu
# hosting (Vercel, etc.) ya lo hace en su propio proxy/edge.
DJANGO_SECURE_SSL_REDIRECT=False

# Cloudinary — repositorio externo de imágenes (solo backend, nunca al frontend).
# OPCIONAL: cada usuario configura su propio repositorio desde la interfaz
# (módulo Repositorio → "Configurar repositorio"), cifrado en base de datos.
# Completar estas variables solo sirve como repositorio de fallback para
# usuarios que todavía no configuraron uno propio — puedes dejarlas vacías.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional: valor inicial del repositorio de fallback. La carpeta real a
# sincronizar se elige desde la interfaz (no hace falta editar esto ni
# reiniciar el backend para usar una carpeta nueva creada en Cloudinary).
CLOUDINARY_DEFAULT_FOLDER=agrovision

# Clave de cifrado para los api_secret guardados por usuario (opcional). Si se
# omite, se deriva de SECRET_KEY (hash SHA-256, no en texto plano). Fijar una
# propia en producción permite rotar SECRET_KEY sin perder los secretos ya
# cifrados en BD. Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REPOSITORY_ENCRYPTION_KEY=

# Geocodificación — opcional, valores por defecto usan Nominatim/OpenStreetMap.
# Cambia NOMINATIM_BASE_URL para apuntar a otro proveedor sin tocar código.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AgriVisionOS/1.0

# Dispositivo de inferencia de Mask R-CNN — opcional. "auto" (por defecto)
# detecta GPU (CUDA) y usa CPU si no hay ninguna disponible. Forzar con
# ML_DEVICE=cpu o ML_DEVICE=cuda.
ML_DEVICE=auto
