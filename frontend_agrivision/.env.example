# URL del backend Django, usada tanto por el servidor Next.js (SSR/API routes)
# como por el navegador. Única variable leída por lib/api.ts (BACKEND_BASE_URL).
#
# Desarrollo local (valor real a usar tal cual):
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Producción (Vercel): NO se define aquí — se configura como variable de
# entorno en Vercel > Settings > Environment Variables del proyecto del
# FRONTEND, con la URL pública real del backend ya desplegado, por ejemplo:
#   NEXT_PUBLIC_API_URL=https://URL-REAL-DEL-BACKEND.vercel.app
# (debe incluir el esquema https:// y no terminar en "/").
